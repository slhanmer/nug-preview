# ---------------------------------------------------------------------------
# DATABASE
#
# Local development uses a Neon project directly — same engine as production,
# and worth the familiarity because Neon is not just hosted Postgres.
#
# Neon gives you TWO connection strings for the same database:
#
#   pooled    hostname contains "-pooler". PgBouncer in transaction mode.
#             Right for serverless, where connections are many and short-lived.
#             Does NOT support session-level features, which some migrations use.
#
#   direct    no "-pooler". A real session.
#
# LOCALLY: use the direct one for everything. One developer, one connection —
# pooling buys nothing and migrations just work.
#
# IN PRODUCTION: the app uses pooled, migrations use direct. The Neon resource
# on the client's Vercel team injects DATABASE_URL; the direct one is added
# alongside it.
#
# Free-tier compute autosuspends after a few minutes idle, so the first query
# after a break takes a second. Not a bug.
#
# Offline alternative: docker-compose.yml in this repo runs Postgres 17 locally.
# Same engine, no network. Swap the URL for the one in that file.
# ---------------------------------------------------------------------------
# Any long random string. Rotating it invalidates every admin session.
# Generate one with:  openssl rand -base64 32
PAYLOAD_SECRET=

# Public URL of the site. Used for metadataBase, sitemap and absolute links.
NEXT_PUBLIC_SITE_URL=http://localhost:3001

# Postgres — your database connection
DATABASE_URL=
DATABASE_URL_POOLED=


# ---------------------------------------------------------------------------
# COMMERCE (the `commerce` module)
#
# The shop renders from the CMS with none of these set — only the buy button
# needs them. A mock is fine on test keys.
#
# THE KEYS ARE THE CLIENT'S. One repo and one deployment per client means their
# secret key sits in their own project and they process their own payments.
# Nothing is routed through us and there is no Connect platform to run.
# ---------------------------------------------------------------------------

# Secret key. sk_test_... for a mock, sk_live_... on a client's own deployment.
STRIPE_SECRET_KEY=

# Signing secret for /webhooks/stripe. Without it orders are never recorded —
# the endpoint logs loudly and returns 200 so Stripe does not retry for days.
# Locally: stripe listen --forward-to localhost:3000/webhooks/stripe
STRIPE_WEBHOOK_SECRET=

# ISO 4217, lowercase. Defaults to aud.
STRIPE_CURRENCY=aud

# ---------------------------------------------------------------------------
# CONTACT FORM
#
# Needed by any site with a `contact` block. Without them the action logs
# NOT CONFIGURED, refuses every submission and shows the business's phone
# number instead — graceful, but not what you want a prospect to meet.
#
# THE RESEND ACCOUNT IS THE CLIENT'S, on the client's own domain, exactly like
# their Stripe. CONTACT_FROM has to be an address on a domain verified in that
# account or Resend refuses the send.
# ---------------------------------------------------------------------------

RESEND_API_KEY=
CONTACT_FROM=
# Where an enquiry lands. Falls back to business.email in site.config.ts.
CONTACT_TO=


# ---------------------------------------------------------------------------
# TURNSTILE — the spam check
#
# ⚠️ NOT NEEDED WHILE `demo: true`. A mock renders no widget and skips the
# check on purpose: that is what stops the form erroring the one time somebody
# presses Send in front of a prospect. These become required the day the demo
# flag comes off.
#
# NEXT_PUBLIC_TURNSTILE_SITE_KEY is inlined at BUILD time. If it is absent when
# the bundle is built the widget never renders, no token is ever posted, and
# every submission fails a check the visitor cannot see. Set it and REDEPLOY.
# ---------------------------------------------------------------------------

NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
