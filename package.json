{
  "name": "starter",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "prepare": "simple-git-hooks",
    "dev": "next dev",
    "new": "node scripts/new-demo.mjs",
    "use": "node scripts/use-demo.mjs",
    "seed": "node scripts/seed.mjs",
    "user": "node scripts/user.mjs",
    "eject": "node scripts/eject.mjs",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "skin:check": "vitest run --project unit src/skins/skins.test.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
